with Files("**"):
    BUG_COMPONENT = ("Core", "Graphics")
    SCHEDULES.inclusive += ["android-hw-gfx"]
with Files("wr/**"):
    BUG_COMPONENT = ("Core", "Graphics: WebRender")
with Files("cairo/**"):
    BUG_COMPONENT = ("Core", "Graphics: Cairo")
with Files("skia/**"):
    BUG_COMPONENT = ("Core", "Graphics: Skia")
with Files("angle/**"):
    BUG_COMPONENT = ("Core", "Graphics: ANGLE")

if CONFIG["MOZ_SYSTEM_GRAPHITE2"]:
    DIRS += ["graphite2/geckoextra"]
else:
    DIRS += ["graphite2/src"]

if not CONFIG["MOZ_SYSTEM_HARFBUZZ"]:
    DIRS += ["harfbuzz/src"]

DIRS += [
    "cairo",
    "2d",
    "ycbcr",
    "angle",
    "src",
    "qcms",
    "gl",
    "layers",
    "ots/src",
    "thebes",
    "ipc",
    "vr",
    "config",
    "webrender_bindings",
    "wgpu_bindings",
    "skia",
]

if CONFIG["MOZ_TREE_PIXMAN"]:
    DIRS += ["pixman"]

if CONFIG["MOZ_FONTATIONS"]:
    DIRS += [
        "fontations_glue",
    ]

TEST_DIRS += ["tests/gtest"]

if CONFIG["FUZZING_INTERFACES"]:
    TEST_DIRS += ["tests/fuzz"]

TEST_DIRS += ["tests"]

SPHINX_TREES["/gfx"] = "docs"

with Files("docs/**"):
    SCHEDULES.exclusive = ["docs"]

LICENSED_UNDER += ["chromium"]
LICENSED_UNDER["chromium"].paths = [
    "ots",
]

LICENSED_UNDER += ["harfbuzz"]
LICENSED_UNDER["harfbuzz"].paths = [
    "harfbuzz",
]

LICENSED_UNDER += ["lgpl"]
LICENSED_UNDER["lgpl"].paths = [
    "graphite2",
]

LICENSED_UNDER += ["unicode-v3"]
LICENSED_UNDER["unicode-v3"].paths = [
    "harfbuzz_glue",
]
